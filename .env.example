# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx   # Gizli! Sadece server-side kullanılır, .env'de kalmalı

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://matematikozelders.com

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=bildirim@matematikozelders.com
ADMIN_EMAIL=ogretmen@matematikozelders.com

# --- Cron güvenliği ---
CRON_SECRET=rastgele-uzun-bir-string-uret

# --- Google OAuth ---
# Client ID/Secret Supabase Dashboard > Authentication > Providers > Google kısmına girilir,
# .env dosyasına eklenmesi GEREKMEZ. Sadece redirect URL'lerin doğru ayarlandığından emin ol:
# Supabase: https://xxxxx.supabase.co/auth/v1/callback
# Uygulama: <NEXT_PUBLIC_SITE_URL>/auth/callback

# --- Instagram Graph API (Faz 4) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Ödeme (Faz 2 - Iyzico örnek) ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
